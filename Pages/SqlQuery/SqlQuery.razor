@page "/sql-query"
@using BlazorDemos.Shared
@inject SqlQueryService SqlQueryService

<div class="control-section">
    <div class="sql-query-container">
        <h2>SQL Server Query Runner</h2>

        <div class="connection-status">
            <span class="status-label">Connection:</span>
            @if (_connectionTested)
            {
                @if (_connectionOk)
                {
                    <span class="status-ok">Connected</span>
                }
                else
                {
                    <span class="status-error">Failed - check connection string in appsettings.json</span>
                }
            }
            else
            {
                <span class="status-pending">Not tested</span>
            }
            <button class="e-btn e-small" @onclick="TestConnection" disabled="@_isRunning">Test Connection</button>
        </div>

        <div class="query-editor">
            <label for="queryInput">SQL Query:</label>
            <textarea id="queryInput"
                      class="query-textarea"
                      @bind="_sqlQuery"
                      placeholder="SELECT TOP 10 * FROM sys.tables" />
        </div>

        <div class="query-actions">
            <button class="e-btn e-primary" @onclick="RunQuery" disabled="@_isRunning">
                @if (_isRunning)
                {
                    <span>Running...</span>
                }
                else
                {
                    <span>Run Query</span>
                }
            </button>
            <button class="e-btn" @onclick="ClearAll">Clear</button>
        </div>

        @if (_result != null)
        {
            <div class="query-results">
                @if (_result.HasError)
                {
                    <div class="error-message">@_result.ErrorMessage</div>
                }
                else if (_result.Columns.Count == 0)
                {
                    <div class="non-query-result">
                        Query executed successfully. Rows affected: <strong>@_result.RowsAffected</strong>
                    </div>
                }
                else
                {
                    <p class="result-count">@_result.Rows.Count row(s) returned</p>
                    <div class="table-wrapper">
                        <table class="result-table">
                            <thead>
                                <tr>
                                    @foreach (var col in _result.Columns)
                                    {
                                        <th>@col</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _result.Rows)
                                {
                                    <tr>
                                        @foreach (var col in _result.Columns)
                                        {
                                            <td>@(row.ContainsKey(col) && row[col] != null ? row[col].ToString() : "NULL")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .sql-query-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 20px;
        font-family: sans-serif;
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        padding: 10px 14px;
        background: #f5f5f5;
        border-radius: 4px;
    }

    .status-label { font-weight: 600; }
    .status-ok { color: #2e7d32; font-weight: 600; }
    .status-error { color: #c62828; font-weight: 600; }
    .status-pending { color: #555; }

    .query-editor {
        margin-bottom: 12px;
    }

    .query-editor label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .query-textarea {
        width: 100%;
        height: 140px;
        font-family: 'Courier New', monospace;
        font-size: 14px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
        box-sizing: border-box;
    }

    .query-actions {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .error-message {
        color: #c62828;
        background: #ffebee;
        border: 1px solid #ef9a9a;
        border-radius: 4px;
        padding: 12px 16px;
    }

    .non-query-result {
        color: #1b5e20;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 4px;
        padding: 12px 16px;
    }

    .result-count {
        color: #555;
        margin-bottom: 8px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .result-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .result-table th {
        background: #1565c0;
        color: white;
        padding: 8px 12px;
        text-align: left;
        white-space: nowrap;
    }

    .result-table td {
        padding: 7px 12px;
        border-bottom: 1px solid #e0e0e0;
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .result-table tr:hover td {
        background: #e3f2fd;
    }
</style>

@code {
    private string _sqlQuery = "SELECT TOP 10 name, object_id, type_desc, create_date FROM sys.tables ORDER BY name;";
    private QueryResult _result;
    private bool _isRunning;
    private bool _connectionTested;
    private bool _connectionOk;

    private async Task TestConnection()
    {
        _isRunning = true;
        _connectionTested = false;
        StateHasChanged();

        _connectionOk = await SqlQueryService.TestConnectionAsync();
        _connectionTested = true;
        _isRunning = false;
    }

    private async Task RunQuery()
    {
        if (string.IsNullOrWhiteSpace(_sqlQuery)) return;

        _isRunning = true;
        _result = null;
        StateHasChanged();

        _result = await SqlQueryService.ExecuteQueryAsync(_sqlQuery);
        _isRunning = false;
    }

    private void ClearAll()
    {
        _sqlQuery = string.Empty;
        _result = null;
        _connectionTested = false;
    }
}
